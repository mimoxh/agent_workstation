{
  "id": "design",
  "name": "前端设计工作台",
  "version": "1.1.0",
  "description": "用对话生成可交互的前端设计稿：画布预览、圈选评论、直接改字、旋钮微调、设计系统，定稿后交给开发台实现",
  "steward": "designer",
  "entities": {
    "Design": {
      "label": "设计稿",
      "description": "一份完整的 HTML 设计稿。每次修改都是一个新版本，可回滚",
      "titleField": "title",
      "fields": {
        "title": {
          "type": "string",
          "label": "标题",
          "required": true
        },
        "html": {
          "type": "text",
          "label": "HTML",
          "required": true
        },
        "brief": {
          "type": "text",
          "label": "需求"
        },
        "group": {
          "type": "string",
          "label": "方案组",
          "description": "同一需求的多个方向用同一个方案组名"
        },
        "direction": {
          "type": "string",
          "label": "方向",
          "description": "这个方向一句话的设计取向"
        },
        "tweaks": {
          "type": "json",
          "label": "旋钮"
        },
        "status": {
          "type": "enum",
          "label": "状态",
          "enum": [
            "draft",
            "approved",
            "handed_off"
          ]
        },
        "handoff": {
          "type": "json",
          "label": "交接记录"
        }
      }
    },
    "DesignComment": {
      "label": "设计评论",
      "description": "锚定在设计稿某个元素上的评论",
      "titleField": "body",
      "fields": {
        "design": {
          "type": "ref",
          "label": "设计稿",
          "refTo": "Design",
          "required": true
        },
        "version": {
          "type": "number",
          "label": "版本"
        },
        "selector": {
          "type": "string",
          "label": "元素"
        },
        "anchor": {
          "type": "string",
          "label": "元素文字"
        },
        "body": {
          "type": "text",
          "label": "内容",
          "required": true
        },
        "status": {
          "type": "enum",
          "label": "状态",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "note": {
          "type": "text",
          "label": "处理说明"
        }
      }
    },
    "DesignSystem": {
      "label": "设计系统",
      "description": "本台所有设计稿共用的设计令牌和设计规范",
      "titleField": "name",
      "fields": {
        "name": {
          "type": "string",
          "label": "名称",
          "required": true
        },
        "tokens": {
          "type": "json",
          "label": "令牌"
        },
        "guidelines": {
          "type": "markdown",
          "label": "设计规范"
        }
      }
    }
  },
  "panels": [
    {
      "id": "canvas",
      "type": "canvas",
      "entity": "Design",
      "title": "设计画布",
      "editableBy": [
        "human",
        "agent"
      ],
      "config": {
        "home": true
      }
    },
    {
      "id": "system",
      "type": "tokens",
      "entity": "DesignSystem",
      "title": "设计系统",
      "editableBy": [
        "human",
        "agent"
      ]
    },
    {
      "id": "knowledge",
      "type": "knowledge",
      "entity": "system:knowledge",
      "title": "知识库",
      "editableBy": [
        "human"
      ]
    }
  ],
  "agents": [
    {
      "id": "designer",
      "promptFile": "designer.md",
      "name": "设计师",
      "role": "理解需求，产出和迭代 HTML 设计稿，维护设计系统，对外代表",
      "tools": [
        "list_designs",
        "read_design",
        "write_design",
        "edit_design",
        "read_design_system",
        "update_design_system",
        "resolve_design_comments",
        "view_design",
        "search_knowledge",
        "send_message",
        "record_decision",
        "request_human"
      ],
      "triggers": [
        "mentioned"
      ]
    },
    {
      "id": "design-critic",
      "promptFile": "critic.md",
      "name": "设计评审",
      "role": "只读评审：层级、对比度、一致性、可用性，把意见钉在具体元素上",
      "tools": [
        "list_designs",
        "read_design",
        "read_design_system",
        "comment_design",
        "view_design",
        "search_knowledge",
        "send_message"
      ],
      "triggers": [
        "mentioned"
      ]
    }
  ],
  "tasks": [],
  "modules": {
    "conversation": {
      "defaultMode": "moderated",
      "maxTurns": 8,
      "summaryEvery": 100
    },
    "knowledge": {
      "scope": "project",
      "acceptedTypes": [
        "md",
        "txt"
      ],
      "retrieval": {
        "strategy": "fts",
        "topK": 5,
        "maxTokens": 3000
      },
      "citation": "preferred"
    }
  },
  "defaults": {
    "writeMode": "direct",
    "taskBudget": {
      "tokens": 400000,
      "minutes": 20
    }
  }
}
