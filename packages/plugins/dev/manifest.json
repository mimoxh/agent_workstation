{
  "id": "dev",
  "name": "全栈开发工作台",
  "version": "1.5.0",
  "description": "多 Agent 分工 + 可执行验收的软件开发工作台",
  "steward": "architect",
  "entities": {
    "Module": {
      "label": "模块",
      "description": "代码域划分，用于派活与边界校验",
      "titleField": "name",
      "fields": {
        "name": { "type": "string", "label": "名称", "required": true },
        "path": { "type": "string", "label": "路径", "required": true },
        "responsibility": { "type": "text", "label": "职责" },
        "owner": { "type": "string", "label": "负责人" }
      }
    },
    "ADR": {
      "label": "架构决策",
      "description": "架构决策记录，防止 Agent 忘了为什么",
      "titleField": "title",
      "fields": {
        "title": { "type": "string", "label": "标题", "required": true },
        "context": { "type": "text", "label": "背景" },
        "decision": { "type": "text", "label": "决策" },
        "consequences": { "type": "text", "label": "后果" },
        "status": { "type": "enum", "label": "状态", "enum": ["proposed", "accepted", "superseded"] }
      }
    },
    "TestRun": {
      "label": "测试运行",
      "description": "可执行验收的证据",
      "titleField": "command",
      "fields": {
        "command": { "type": "string", "label": "命令", "required": true },
        "status": { "type": "enum", "label": "状态", "enum": ["passed", "failed", "error"] },
        "duration": { "type": "number", "label": "耗时(s)" },
        "output_ref": { "type": "string", "label": "输出" },
        "commit_sha": { "type": "string", "label": "提交" }
      }
    },
    "Page": {
      "label": "页面",
      "description": "前端页面（可选的领域实体）",
      "titleField": "route",
      "fields": {
        "route": { "type": "string", "label": "路由", "required": true },
        "name": { "type": "string", "label": "名称" },
        "status": { "type": "string", "label": "状态" },
        "screenshot_ref": { "type": "string", "label": "截图" }
      }
    }
  },
  "stages": [
    { "id": "requirement", "name": "需求", "activePanels": ["board"], "activeAgents": ["architect"] },
    {
      "id": "design",
      "name": "设计",
      "requirements": [{ "kind": "new_scope_decision", "registry": "Module", "pathField": "path", "decision": "ADR", "description": "涉及新 Module 时需有 ADR" }],
      "activePanels": ["board", "decisions"],
      "activeAgents": ["architect"]
    },
    { "id": "implement", "name": "实现", "activePanels": ["board", "changes"], "activeAgents": ["frontend-dev", "backend-dev"] },
    {
      "id": "test",
      "name": "测试",
      "requirements": [{ "kind": "acceptance" }],
      "activePanels": ["tests", "changes"],
      "activeAgents": ["test-engineer"]
    },
    {
      "id": "review",
      "name": "评审",
      "requirements": [{ "kind": "approval" }],
      "activePanels": ["changes"],
      "activeAgents": ["reviewer"]
    },
    { "id": "merge", "name": "合并", "activePanels": ["changes"], "activeAgents": [] }
  ],
  "panels": [
    { "id": "board", "type": "board", "entity": "system:task", "title": "任务看板", "editableBy": ["human", "agent"], "config": { "field": "stage" } },
    { "id": "changes", "type": "diff", "entity": "system:proposal", "title": "改动审阅", "editableBy": ["human", "agent"], "config": { "showComments": true } },
    { "id": "tests", "type": "table", "entity": "TestRun", "title": "测试结果", "editableBy": ["human"] },
    { "id": "decisions", "type": "table", "entity": "ADR", "title": "架构决策", "editableBy": ["human", "agent"] },
    { "id": "modules", "type": "table", "entity": "Module", "title": "模块登记", "editableBy": ["human", "agent"] },
    { "id": "files", "type": "tree", "entity": "system:files", "title": "文件树", "editableBy": ["human"] },
    { "id": "preview", "type": "preview", "entity": "Page", "title": "页面预览", "editableBy": ["human"], "config": { "urlField": "route", "baselineField": "screenshot_ref" } },
    { "id": "knowledge", "type": "knowledge", "entity": "system:knowledge", "title": "知识库", "editableBy": ["human"] }
  ],
  "agents": [
    {
      "id": "architect", "promptFile": "architect.md",
      "name": "架构师",
      "role": "拆模块、定接口、写 ADR、对外代表",
      "tools": ["read_entity", "list_entities", "propose_entity", "create_task", "send_message", "record_decision", "search_knowledge", "search_code", "list_files", "git_diff", "report_blocked", "request_human", "respond_task", "resolve_block", "escalate_block", "advance_stage", "read_design_handoff"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    },
    {
      "id": "frontend-dev", "promptFile": "implementer.md",
      "name": "前端开发",
      "role": "页面、组件、样式、交互",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "sync_branch", "submit_change", "run_command", "search_knowledge", "send_message", "report_blocked", "read_design_handoff"],
      "triggers": ["task_assigned", "mentioned"]
    },
    {
      "id": "backend-dev", "promptFile": "implementer.md",
      "name": "后端开发",
      "role": "API、数据层、任务编排",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "sync_branch", "submit_change", "run_command", "search_knowledge", "send_message", "report_blocked"],
      "triggers": ["task_assigned", "mentioned"]
    },
    {
      "id": "test-engineer", "promptFile": "test-engineer.md",
      "name": "测试工程师",
      "role": "写测试、跑测试、出报告",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "run_command", "run_tests", "capture_screenshot", "send_message"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    },
    {
      "id": "reviewer", "promptFile": "reviewer.md",
      "name": "审查",
      "role": "只读 diff，独立上下文：逐行评论并给出 approve / request_changes",
      "tools": ["git_diff", "read_file", "list_files", "read_entity", "list_entities", "search_knowledge", "review_change", "send_message"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    }
  ],
  "tasks": [
    {
      "id": "dev.issue",
      "name": "开发任务",
      "description": "任务在开发台内的形态：feature / bug / chore / scaffold（从零搭脚手架）/ refactor（跨 Module 重构）/ deps（依赖升级），改动限定在声明的 module 范围内",
      "stages": ["requirement", "design", "implement", "test", "review", "merge"],
      "inputSchema": {
        "type": "object",
        "required": ["title", "kind", "priority", "module"],
        "properties": {
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["feature", "bug", "chore", "scaffold", "refactor", "deps"] },
          "priority": { "type": "string", "enum": ["p0", "p1", "p2"] },
          "module": { "type": "string", "description": "改动范围：一个或多个路径，逗号分隔（跨 Module 重构）；. 表示整个仓库（脚手架）。改动不得越出这些路径；deps 任务额外允许改 package.json 与锁文件" },
          "design_artifact": { "type": "string", "description": "设计台交接的设计稿，用 read_design_handoff 读取；拆子任务时不用重复填" }
        }
      },
      "acceptance": [{ "kind": "command", "run": "pnpm build", "expect": { "exitCode": 0 } }]
    }
  ],
  "modules": {
    "conversation": { "defaultMode": "moderated", "threadOverrides": { "task": "moderated" }, "maxTurns": 12, "summaryEvery": 6 },
    "knowledge": { "scope": "project", "acceptedTypes": ["md", "txt"], "retrieval": { "strategy": "fts", "topK": 5, "maxTokens": 3000 }, "citation": "required" }
  },
  "presets": [
    { "id": "dev-standard", "name": "标准协作", "description": "成员可以互相点名讨论，主持人定期收束成结论", "patch": {} },
    {
      "id": "dev-relay",
      "name": "快速接力",
      "description": "任务里只按流程交接，不展开讨论，成本最低",
      "patch": { "modules": { "conversation": { "defaultMode": "moderated", "threadOverrides": { "task": "relay" } } } }
    }
  ],
  "defaults": {
    "writeMode": "propose",
    "taskBudget": { "tokens": 200000, "minutes": 30 }
  }
}
