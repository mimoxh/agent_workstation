{
  "id": "dev",
  "name": "全栈开发工作台",
  "version": "1.9.1",
  "description": "多 Agent 分工 + 可执行验收的软件开发工作台：设计画布 → 实现 → 审查合并 → 版本回归与发布结论，一台走完（原设计台、测试台并入）",
  "steward": "architect",
  "entities": {
    "Module": {
      "label": "模块",
      "description": "代码域划分，用于派活与边界校验",
      "titleField": "name",
      "fields": {
        "name": { "type": "string", "label": "名称", "required": true },
        "path": { "type": "string", "label": "路径", "required": true },
        "responsibility": { "type": "text", "label": "职责" },
        "owner": { "type": "string", "label": "负责人" }
      }
    },
    "ADR": {
      "label": "架构决策",
      "description": "架构决策记录，防止 Agent 忘了为什么",
      "titleField": "title",
      "fields": {
        "title": { "type": "string", "label": "标题", "required": true },
        "context": { "type": "text", "label": "背景" },
        "decision": { "type": "text", "label": "决策" },
        "consequences": { "type": "text", "label": "后果" },
        "status": { "type": "enum", "label": "状态", "enum": ["proposed", "accepted", "superseded"] }
      }
    },
    "TestRun": {
      "label": "测试运行",
      "description": "可执行验收的证据",
      "titleField": "command",
      "fields": {
        "command": { "type": "string", "label": "命令", "required": true },
        "status": { "type": "enum", "label": "状态", "enum": ["passed", "failed", "error"] },
        "duration": { "type": "number", "label": "耗时(s)" },
        "output_ref": { "type": "string", "label": "输出" },
        "commit_sha": { "type": "string", "label": "提交" }
      }
    },
    "Page": {
      "label": "页面",
      "description": "前端页面（可选的领域实体）",
      "titleField": "route",
      "fields": {
        "route": { "type": "string", "label": "路由", "required": true },
        "name": { "type": "string", "label": "名称" },
        "status": { "type": "string", "label": "状态" },
        "screenshot_ref": { "type": "string", "label": "截图" }
      }
    },
    "Design": {
      "label": "设计稿",
      "description": "一份完整的 HTML 设计稿。每次修改都是一个新版本，可回滚",
      "titleField": "title",
      "writeMode": "direct",
      "fields": {
        "title": { "type": "string", "label": "标题", "required": true },
        "html": { "type": "text", "label": "HTML", "required": true },
        "brief": { "type": "text", "label": "需求" },
        "group": { "type": "string", "label": "方案组", "description": "同一需求的多个方向用同一个方案组名" },
        "direction": { "type": "string", "label": "方向", "description": "这个方向一句话的设计取向" },
        "tweaks": { "type": "json", "label": "旋钮" },
        "status": { "type": "enum", "label": "状态", "enum": ["draft", "approved", "handed_off"] },
        "handoff": { "type": "json", "label": "交接记录" },
        "legacyTokens": { "type": "json", "label": "旧版令牌" }
      }
    },
    "DesignComment": {
      "label": "设计评论",
      "description": "锚定在设计稿某个元素上的评论",
      "titleField": "body",
      "writeMode": "direct",
      "fields": {
        "design": { "type": "ref", "label": "设计稿", "refTo": "Design", "required": true },
        "version": { "type": "number", "label": "版本" },
        "selector": { "type": "string", "label": "元素" },
        "anchor": { "type": "string", "label": "元素文字" },
        "body": { "type": "text", "label": "内容", "required": true },
        "status": { "type": "enum", "label": "状态", "enum": ["open", "resolved"] },
        "note": { "type": "text", "label": "处理说明" }
      }
    },
    "TestSuite": {
      "label": "测试套件",
      "description": "一条可执行的测试命令及其报告位置。命令由人审定，Agent 只能按 id 运行",
      "titleField": "name",
      "writeMode": "propose",
      "fields": {
        "name": { "type": "string", "label": "名称", "required": true },
        "command": { "type": "string", "label": "命令", "required": true, "description": "在仓库根目录执行，不能用管道和变量" },
        "report_path": { "type": "string", "label": "JUnit 报告路径", "required": true, "description": "相对仓库根目录" },
        "coverage_path": { "type": "string", "label": "覆盖率报告路径", "description": "coverage-summary.json 或 lcov.info" },
        "timeout_sec": { "type": "number", "label": "超时(秒)" },
        "auto_run": { "type": "boolean", "label": "目标分支更新时自动运行" },
        "schedule": { "type": "enum", "label": "定时运行", "enum": ["off", "hourly", "every6h", "daily"] },
        "schedule_at": { "type": "string", "label": "每日时间", "description": "HH:MM，本机时间，daily 时生效" },
        "description": { "type": "text", "label": "说明" }
      }
    },
    "TestCase": {
      "label": "测试用例",
      "description": "手工或自动化用例。AI 生成的先是草稿，人审后入库",
      "titleField": "title",
      "writeMode": "direct",
      "fields": {
        "title": { "type": "string", "label": "标题", "required": true },
        "module": { "type": "string", "label": "模块" },
        "priority": { "type": "enum", "label": "优先级", "enum": ["p0", "p1", "p2"] },
        "status": { "type": "enum", "label": "状态", "enum": ["draft", "active", "deprecated"] },
        "preconditions": { "type": "text", "label": "前置条件" },
        "steps": { "type": "json", "label": "步骤", "description": "[{ action, expected }]" },
        "requirement": { "type": "text", "label": "需求来源" },
        "automation_key": { "type": "string", "label": "自动化用例标识" },
        "automation_name": { "type": "string", "label": "自动化用例名" },
        "handoff": { "type": "json", "label": "交接记录" }
      }
    },
    "TestPlan": {
      "label": "测试计划",
      "description": "面向一个版本：要跑的套件、手工用例、准出标准和结论",
      "titleField": "name",
      "writeMode": "direct",
      "fields": {
        "name": { "type": "string", "label": "名称", "required": true },
        "version": { "type": "string", "label": "版本" },
        "ref": { "type": "string", "label": "分支或提交" },
        "status": { "type": "enum", "label": "状态", "enum": ["draft", "running", "signed"] },
        "suites": { "type": "json", "label": "套件" },
        "cases": { "type": "json", "label": "手工用例" },
        "criteria": { "type": "json", "label": "准出标准" },
        "manual_results": { "type": "json", "label": "手工结果" },
        "run_ids": { "type": "json", "label": "运行" },
        "milestone": { "type": "string", "label": "里程碑", "description": "根工作台里程碑的 id" },
        "summary": { "type": "markdown", "label": "结论摘要" },
        "signoff": { "type": "json", "label": "签字" }
      }
    },
    "BugReport": {
      "label": "缺陷",
      "description": "从失败里确认下来的问题，在本台生成修复任务，回归后自动验证",
      "titleField": "title",
      "writeMode": "direct",
      "fields": {
        "title": { "type": "string", "label": "标题", "required": true },
        "severity": { "type": "enum", "label": "严重度", "enum": ["p0", "p1", "p2", "p3"], "required": true },
        "status": { "type": "enum", "label": "状态", "enum": ["draft", "open", "fixing", "verifying", "verified", "reopened", "wontfix"] },
        "module": { "type": "string", "label": "模块" },
        "steps": { "type": "text", "label": "复现步骤" },
        "expected": { "type": "text", "label": "期望" },
        "actual": { "type": "text", "label": "实际" },
        "run_id": { "type": "string", "label": "运行" },
        "case_key": { "type": "string", "label": "自动化用例标识" },
        "case_name": { "type": "string", "label": "用例" },
        "handoff": { "type": "json", "label": "交接记录" },
        "verifying_since": { "type": "date", "label": "开始验证" },
        "note": { "type": "text", "label": "备注" }
      }
    },
    "TestQuarantine": {
      "label": "隔离记录",
      "description": "被隔离的不稳定用例：仍然运行和展示，但不计入发布结论",
      "titleField": "name",
      "writeMode": "propose",
      "fields": {
        "name": { "type": "string", "label": "用例", "required": true },
        "case_key": { "type": "string", "label": "用例标识", "required": true },
        "reason": { "type": "text", "label": "原因" },
        "status": { "type": "enum", "label": "状态", "enum": ["active", "released"] }
      }
    }
  },
  "stages": [
    { "id": "requirement", "name": "需求", "activePanels": ["board"], "activeAgents": ["architect"] },
    {
      "id": "design",
      "name": "设计",
      "requirements": [{ "kind": "new_scope_decision", "registry": "Module", "pathField": "path", "decision": "ADR", "description": "涉及新 Module 时需有 ADR" }],
      "activePanels": ["board", "decisions"],
      "activeAgents": ["architect"]
    },
    { "id": "implement", "name": "实现", "activePanels": ["board", "changes"], "activeAgents": ["frontend-dev", "backend-dev"] },
    {
      "id": "test",
      "name": "测试",
      "requirements": [{ "kind": "acceptance" }],
      "activePanels": ["runs", "changes"],
      "activeAgents": ["test-engineer"]
    },
    {
      "id": "review",
      "name": "评审",
      "requirements": [{ "kind": "approval" }],
      "activePanels": ["changes"],
      "activeAgents": ["reviewer"]
    },
    { "id": "merge", "name": "合并", "activePanels": ["changes"], "activeAgents": [] }
  ],
  "panels": [
    { "id": "board", "type": "board", "entity": "system:task", "title": "任务看板", "editableBy": ["human", "agent"], "config": { "field": "stage" } },
    { "id": "canvas", "type": "canvas", "entity": "Design", "title": "设计画布", "editableBy": ["human", "agent"] },
    { "id": "changes", "type": "diff", "entity": "system:proposal", "title": "改动审阅", "editableBy": ["human", "agent"], "config": { "showComments": true } },
    { "id": "decisions", "type": "table", "entity": "ADR", "title": "架构决策", "editableBy": ["human", "agent"] },
    { "id": "modules", "type": "table", "entity": "Module", "title": "模块登记", "editableBy": ["human", "agent"] },
    { "id": "files", "type": "tree", "entity": "system:files", "title": "文件树", "editableBy": ["human"] },
    { "id": "preview", "type": "preview", "entity": "Page", "title": "页面预览", "editableBy": ["human"], "config": { "urlField": "route", "baselineField": "screenshot_ref" } },
    { "id": "knowledge", "type": "knowledge", "entity": "system:knowledge", "title": "知识库", "editableBy": ["human"] },
    { "id": "overview", "type": "quality", "entity": "TestSuite", "title": "质量总览", "editableBy": ["human"], "config": { "view": "overview", "group": "测试" } },
    { "id": "runs", "type": "quality", "entity": "TestSuite", "title": "测试运行", "editableBy": ["human", "agent"], "config": { "view": "runs", "group": "测试" } },
    { "id": "cases", "type": "quality", "entity": "TestCase", "title": "用例库", "editableBy": ["human", "agent"], "config": { "view": "cases", "group": "测试" } },
    { "id": "plans", "type": "quality", "entity": "TestPlan", "title": "测试计划", "editableBy": ["human", "agent"], "config": { "view": "plans", "group": "测试" } },
    { "id": "bugs", "type": "quality", "entity": "BugReport", "title": "缺陷", "editableBy": ["human", "agent"], "config": { "view": "bugs", "group": "测试" } },
    { "id": "flaky", "type": "quality", "entity": "TestQuarantine", "title": "不稳定用例", "editableBy": ["human"], "config": { "view": "flaky", "group": "测试" } },
    { "id": "coverage", "type": "quality", "entity": "TestSuite", "title": "覆盖率", "editableBy": ["human"], "config": { "view": "coverage", "group": "测试" } }
  ],
  "agents": [
    {
      "id": "architect", "promptFile": "architect.md",
      "name": "架构师",
      "role": "拆模块、定接口、写 ADR、对外代表",
      "tools": ["read_entity", "list_entities", "propose_entity", "create_task", "send_message", "record_decision", "search_knowledge", "search_code", "list_files", "git_diff", "report_blocked", "request_human", "respond_task", "resolve_block", "escalate_block", "advance_stage", "read_design_handoff", "read_doc_handoff"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    },
    {
      "id": "frontend-dev", "promptFile": "implementer.md",
      "name": "前端开发",
      "role": "页面、组件、样式、交互",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "sync_branch", "submit_change", "run_command", "search_knowledge", "send_message", "report_blocked", "read_design_handoff", "read_doc_handoff"],
      "triggers": ["task_assigned", "mentioned"]
    },
    {
      "id": "backend-dev", "promptFile": "implementer.md",
      "name": "后端开发",
      "role": "API、数据层、任务编排",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "sync_branch", "submit_change", "run_command", "search_knowledge", "send_message", "report_blocked", "read_doc_handoff"],
      "triggers": ["task_assigned", "mentioned"]
    },
    {
      "id": "test-engineer", "promptFile": "test-engineer.md",
      "name": "测试工程师",
      "role": "写测试、跑测试、出报告",
      "tools": ["read_file", "list_files", "search_code", "git_diff", "apply_patch", "git_commit", "run_command", "run_tests", "capture_screenshot", "send_message"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    },
    {
      "id": "reviewer", "promptFile": "reviewer.md",
      "name": "审查",
      "role": "只读 diff，独立上下文：逐行评论并给出 approve / request_changes",
      "tools": ["git_diff", "read_file", "list_files", "read_entity", "list_entities", "search_knowledge", "review_change", "send_message"],
      "triggers": ["task_assigned", "mentioned", "stage_enter"]
    },
    {
      "id": "designer", "promptFile": "designer.md",
      "name": "设计师",
      "role": "理解需求，产出和迭代 HTML 设计稿",
      "tools": ["list_designs", "read_design", "write_design", "edit_design", "resolve_design_comments", "view_design", "list_folder", "read_folder_file", "search_folder", "search_knowledge", "send_message", "record_decision", "request_human"],
      "triggers": ["mentioned"]
    },
    {
      "id": "design-critic", "promptFile": "critic.md",
      "name": "设计评审",
      "role": "只读评审：层级、对比度、一致性、可用性，把意见钉在具体元素上",
      "tools": ["list_designs", "read_design", "comment_design", "view_design", "list_folder", "read_folder_file", "search_folder", "search_knowledge", "send_message"],
      "triggers": ["mentioned"]
    },
    {
      "id": "qa-lead", "promptFile": "lead.md",
      "name": "测试负责人",
      "role": "排测试计划、跑回归、汇总质量状况并起草发布结论",
      "tools": ["qa_overview", "list_test_suites", "run_test_suite", "get_test_run", "list_flaky_tests", "list_entities", "read_entity", "save_plan_summary", "list_folder", "read_folder_file", "search_folder", "search_knowledge", "send_message", "record_decision", "request_human"],
      "triggers": ["mentioned"]
    },
    {
      "id": "case-designer", "promptFile": "case-designer.md",
      "name": "用例设计",
      "role": "从需求、设计稿和代码设计测试用例，只产出草稿，由人审后入库",
      "tools": ["list_entities", "read_entity", "read_repo_file", "search_repo", "save_test_cases", "read_design_snapshot", "list_folder", "read_folder_file", "search_folder", "search_knowledge", "send_message"],
      "triggers": ["mentioned"]
    },
    {
      "id": "failure-analyst", "promptFile": "failure-analyst.md",
      "name": "失败分析",
      "role": "读失败输出和代码，判断根因类别并给证据，起草缺陷",
      "tools": ["get_test_run", "get_case_history", "read_repo_file", "search_repo", "save_triage", "draft_bug", "list_entities", "list_folder", "read_folder_file", "search_folder", "search_knowledge", "send_message"],
      "triggers": ["mentioned"]
    }
  ],
  "tasks": [
    {
      "id": "dev.issue",
      "name": "开发任务",
      "description": "任务在开发台内的形态：feature / bug / chore / scaffold（从零搭脚手架）/ refactor（跨 Module 重构）/ deps（依赖升级），改动限定在声明的 module 范围内",
      "stages": ["requirement", "design", "implement", "test", "review", "merge"],
      "inputSchema": {
        "type": "object",
        "required": ["title", "kind", "priority", "module"],
        "properties": {
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["feature", "bug", "chore", "scaffold", "refactor", "deps"] },
          "priority": { "type": "string", "enum": ["p0", "p1", "p2"] },
          "module": { "type": "string", "description": "改动范围：一个或多个路径，逗号分隔（跨 Module 重构）；. 表示整个仓库（脚手架）。改动不得越出这些路径；deps 任务额外允许改 package.json 与锁文件" },
          "design_artifact": { "type": "string", "description": "设计台交接的设计稿，用 read_design_handoff 读取；拆子任务时不用重复填" },
          "doc_artifact": { "type": "string", "description": "文档台交接的文档成品，用 read_doc_handoff 读取；拆子任务时不用重复填" }
        }
      },
      "acceptance": [{ "kind": "command", "run": "pnpm build", "expect": { "exitCode": 0 } }]
    }
  ],
  "modules": {
    "conversation": { "defaultMode": "moderated", "threadOverrides": { "task": "moderated" }, "maxTurns": 12, "summaryEvery": 6 },
    "knowledge": { "scope": "project", "acceptedTypes": ["md", "txt"], "retrieval": { "strategy": "fts", "topK": 5, "maxTokens": 3000 }, "citation": "required" }
  },
  "presets": [
    { "id": "dev-standard", "name": "标准协作", "description": "成员可以互相点名讨论，主持人定期收束成结论", "patch": {} },
    {
      "id": "dev-relay",
      "name": "快速接力",
      "description": "任务里只按流程交接，不展开讨论，成本最低",
      "patch": { "modules": { "conversation": { "defaultMode": "moderated", "threadOverrides": { "task": "relay" } } } }
    }
  ],
  "defaults": {
    "writeMode": "propose",
    "taskBudget": { "tokens": 200000, "minutes": 30 }
  }
}
