{
  "id": "pm",
  "name": "项目管理",
  "version": "1.1.0",
  "description": "根工作台：任务立项、派发、依赖与验收",
  "entities": {
    "Milestone": {
      "label": "里程碑",
      "description": "项目级阶段目标，由人维护",
      "titleField": "name",
      "fields": {
        "name": { "type": "string", "label": "名称", "required": true },
        "due": { "type": "date", "label": "截止日期" },
        "status": { "type": "enum", "label": "状态", "enum": ["未开始", "进行中", "已完成"] }
      }
    }
  },
  "panels": [
    { "id": "board", "type": "board", "entity": "system:task", "title": "任务看板", "editableBy": ["human", "agent"], "config": { "field": "status" } },
    { "id": "miles", "type": "timeline", "entity": "Milestone", "title": "里程碑", "editableBy": ["human"] },
    { "id": "knowledge", "type": "knowledge", "entity": "system:knowledge", "title": "知识库", "editableBy": ["human"] }
  ],
  "agents": [
    {
      "id": "pm",
      "name": "项目经理",
      "role": "拆解目标、起草任务契约、分派任务、跟踪阻塞",
      "promptFile": "pm.md",
      "tools": ["read_entity", "list_entities", "search_workstation", "search_knowledge", "create_task", "dispatch_task", "send_message", "record_decision", "request_human", "respond_task"],
      "triggers": ["mentioned", "task_assigned"]
    }
  ],
  "modules": {
    "conversation": { "defaultMode": "moderated", "maxTurns": 12, "summaryEvery": 6 }
  },
  "steward": "pm",
  "tasks": []
}
