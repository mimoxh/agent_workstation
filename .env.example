AW_HOST=127.0.0.1
AW_PORT=8787
AW_DB_PATH=./data/agent-workstation.db

# 模型 provider（复制为 .env.local 填写；密钥绝不进日志/数据库）
# Anthropic
AW_ANTHROPIC_API_KEY=
AW_ANTHROPIC_BASE_URL=          # 可选
AW_ANTHROPIC_MODEL=
# OpenAI 兼容端点
AW_OPENAI_COMPAT_NAME=          # 可选，默认 openai-compat
AW_OPENAI_COMPAT_BASE_URL=
AW_OPENAI_COMPAT_API_KEY=
AW_OPENAI_COMPAT_MODEL=
# Ollama（走 OpenAI 兼容端点，默认 http://localhost:11434/v1）
AW_OLLAMA_MODEL=
AW_OLLAMA_BASE_URL=
# 默认模型：anthropic / openai-compat / provider:model；留空取第一个已配置的 provider
AW_DEFAULT_MODEL=
# Agent 运行
AW_RUN_CONCURRENCY=2
AW_AUTORUN=1
# 脚本化 mock，不调用真实模型；试用时设为 1
AW_ENABLE_MOCK=0

# 设计台 Agent 单次输出的 token 上限（整份 HTML 走一次工具调用）；provider 不接受时调小，0 表示不设
# AW_LARGE_OUTPUT_TOKENS=16000
