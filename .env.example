AW_HOST=127.0.0.1
AW_PORT=8787
AW_DB_PATH=./data/agent-workstation.db

# 模型 provider（复制为 .env.local 填写；密钥绝不进日志/数据库）
# Anthropic
AW_ANTHROPIC_API_KEY=
AW_ANTHROPIC_BASE_URL=          # 可选
AW_ANTHROPIC_MODEL=
# OpenAI 兼容端点
AW_OPENAI_COMPAT_NAME=          # 可选，默认 openai-compat
AW_OPENAI_COMPAT_BASE_URL=
AW_OPENAI_COMPAT_API_KEY=
AW_OPENAI_COMPAT_MODEL=
# 默认模型：anthropic / openai-compat / provider:model
AW_DEFAULT_MODEL=mock:scripted
# Agent 运行
AW_RUN_CONCURRENCY=2
AW_AUTORUN=1
AW_ENABLE_MOCK=0
