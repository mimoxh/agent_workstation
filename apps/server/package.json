{
  "name": "@aw/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:model": "tsx --env-file-if-exists=../../.env.local src/smoke.ts",
    "smoke:worktree": "tsx src/smoke-worktree.ts",
    "db:migrate": "drizzle-kit generate && tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@aw/domain": "workspace:*",
    "@aw/plugin-spec": "workspace:*",
    "@aw/plugins": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "ai": "^7.0.156",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "p-queue": "^10.0.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
