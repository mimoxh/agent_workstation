{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@aw/domain": ["../../packages/domain/src/index.ts"],
      "@aw/plugin-spec": ["../../packages/plugin-spec/src/index.ts"],
      "@aw/plugins": ["../../packages/plugins/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "e2e"]
}
